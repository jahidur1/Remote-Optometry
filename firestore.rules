
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INSTITUTIONAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isUserActive() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.status == 'Active';
    }
    
    function isAdmin() {
      let profile = getProfile();
      return isUserActive() && profile.role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      let profile = getProfile();
      return isUserActive() && profile.role == 'super_admin';
    }

    // --- SYSTEM GOVERNANCE ---

    match /system_settings/whatsapp_config {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    
    match /system_settings/whatsapp_automation {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // --- REGISTRY & ROSTERS ---

    match /offices/{officeId} {
      allow read: if isSignedIn(); 
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false; 
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isUserActive() && (isAdmin() || (getProfile().employeeId == employeeId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['age'])));
    }

    match /published_rosters/{rosterId} { 
      allow read: if isUserActive(); 
      allow write: if isAdmin();
    }

    match /whatsapp_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); 
    }

    match /roster_quotas/{quotaId} { 
      allow read: if isUserActive();
      allow write: if isAdmin();
    }

    match /roster_drafts/{draftId} { 
      allow read: if isAdmin(); 
      allow write: if isAdmin(); 
    }

    match /shift_master/{shiftId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /weekoff_configs/{configId} {
      allow read: if isUserActive();
      allow write: if isAdmin();
    }

    match /weekoff_bookings/{bookingId} {
      allow read: if isUserActive();
      allow create: if isUserActive();
      allow delete, update: if isSuperAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == resource.data.uid);
    }
    
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
    }
  }
}
