
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INSTITUTIONAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(path) && get(path).data.status == 'Active';
    }
    
    function isAdmin() {
      return isUserActive() && getUserData().role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isUserActive() && getUserData().role == 'super_admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOfficeActive(officeId) {
      let path = /databases/$(database)/documents/offices/$(officeId);
      return exists(path) && get(path).data.status == 'Active';
    }

    function matchesOffice(officeId) {
      let user = getUserData();
      return isUserActive() && (
        user.role == 'super_admin' ||
        (user.role == 'admin' && (
          (user.keys().hasAny(['officeIds']) && officeId in user.officeIds) ||
          (!user.keys().hasAny(['officeIds']) && user.office == officeId)
        )) ||
        (user.role == 'user' && user.office == officeId)
      );
    }

    // --- REGISTRY & SHIFTS ---

    match /offices/{officeId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() && officeId == request.resource.data.officeId;
      allow update: if isSuperAdmin() && 
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.shortCode == resource.data.shortCode;
      allow delete: if false;
    }

    match /registry_short_codes/{code} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /shift_master/{shiftId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- IDENTITY ---

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if false; // Provisioned via Trusted Server Actions only
    }

    match /employees/{employeeId} {
      function getEmployeeId() {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        return exists(path) ? get(path).data.employeeId : null;
      }

      allow get: if isSignedIn() && (isAdmin() || getEmployeeId() == employeeId);
      allow list: if isAdmin() && (isSuperAdmin() || matchesOffice(resource.data.office));
      allow create: if false; // Controlled by Server Actions
      allow update: if isUserActive() && (
        (isAdmin() && matchesOffice(resource.data.office)) ||
        (getEmployeeId() == employeeId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['age']))
      );
      allow delete: if isSuperAdmin();
    }

    // --- OPERATIONS ---

    match /weekoff_configs/{configId} {
      allow read: if isUserActive() && matchesOffice(resource.data.office);
      allow write: if isAdmin() && matchesOffice(request.resource.data.office) && isOfficeActive(request.resource.data.office);
    }

    match /weekoff_bookings/{bookingId} {
      function getEmployeeId() {
        return getUserData().employeeId;
      }

      allow read: if isUserActive() && (resource.data.employeeId == getEmployeeId() || matchesOffice(resource.data.office));
      allow create: if isUserActive() && request.resource.data.employeeId == getEmployeeId() && matchesOffice(request.resource.data.office) && isOfficeActive(request.resource.data.office);
      allow delete, update: if isAdmin() && matchesOffice(resource.data.office);
    }

    match /published_rosters/{versionId} { 
      allow read: if isUserActive() && (isAdmin() || matchesOffice(resource.data.office)); 
      allow write: if isAdmin() && matchesOffice(request.resource.data.office) && isOfficeActive(request.resource.data.office);
    }
    
    match /roster_quotas/{quotaId} { 
      // Handle IDs like weekId_officeId
      allow read: if isUserActive() && (isAdmin() || matchesOffice(resource.data.officeId));
      allow write: if isAdmin() && matchesOffice(request.resource.data.officeId) && isOfficeActive(request.resource.data.officeId);
    }

    match /roster_drafts/{draftId} { 
      allow read: if isAdmin() && matchesOffice(resource.data.office); 
      allow write: if isAdmin() && matchesOffice(request.resource.data.office) && isOfficeActive(request.resource.data.office); 
    }

    match /employee_leaves/{leaveId} {
      function getEmployeeId() {
        return getUserData().employeeId;
      }

      allow read: if isUserActive() && (isAdmin() || resource.data.employeeId == getEmployeeId() || matchesOffice(resource.data.office));
      allow write: if isAdmin() && matchesOffice(request.resource.data.office);
    }

    match /shift_adjacency_rules/{ruleId} {
      allow read: if isAdmin() && matchesOffice(resource.data.office);
      allow write: if isAdmin() && matchesOffice(request.resource.data.office);
    }

    match /shift_swaps/{swapId} {
      function getEmployeeId() {
        return getUserData().employeeId;
      }

      allow read: if isUserActive() && (
        isSuperAdmin() || 
        (isAdmin() && matchesOffice(resource.data.office)) || 
        resource.data.requesterId == getEmployeeId() || 
        resource.data.targetEmployeeId == getEmployeeId()
      );
      allow create: if isUserActive() && request.resource.data.requesterId == getEmployeeId() && matchesOffice(request.resource.data.office);
      allow update: if isUserActive() && (request.resource.data.targetEmployeeId == getEmployeeId() || (isAdmin() && matchesOffice(resource.data.office)));
    }

    match /employee_preferences/{prefId} {
      function getEmployeeId() {
        return getUserData().employeeId;
      }

      allow read: if isUserActive() && (isAdmin() || resource.data.employeeId == getEmployeeId() || matchesOffice(resource.data.office));
      allow write: if isUserActive() && request.resource.data.employeeId == getEmployeeId() && matchesOffice(request.resource.data.office);
    }

    // --- LOGS & AUTH ---

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && matchesOffice(resource.data.office));
      allow create: if isSignedIn(); 
    }

    match /whatsapp_logs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && matchesOffice(resource.data.office));
      allow create: if isSignedIn(); 
    }
    
    match /otp_registry/{phone} {
      allow read: if isSuperAdmin();
      allow write: if true; // Publicly accessible for login pulses
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.uid);
    }
  }
}
