
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INSTITUTIONAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isUserActive() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.status == 'Active';
    }
    
    function isAdmin() {
      let profile = getProfile();
      return isUserActive() && profile.role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      let profile = getProfile();
      return isUserActive() && profile.role == 'super_admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMemberOf(officeId) {
      let profile = getProfile();
      return isUserActive() && (
        profile.role == 'super_admin' ||
        (profile.role == 'admin' && (
          (profile.keys().hasAny(['officeIds']) && officeId in profile.officeIds) ||
          (!profile.keys().hasAny(['officeIds']) && profile.office == officeId)
        )) ||
        (profile.role == 'user' && profile.office == officeId)
      );
    }

    // --- REGISTRY & SHIFTS ---

    match /offices/{officeId} {
      allow read: if true; 
      allow create: if isSuperAdmin() && officeId == request.resource.data.officeId;
      allow update: if isSuperAdmin() && 
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.shortCode == resource.data.shortCode;
      allow delete: if false;
    }

    match /registry_short_codes/{code} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /shift_master/{shiftId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- IDENTITY ---

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if false; 
    }

    match /employees/{employeeId} {
      function getEmployeeId() {
        let profile = getProfile();
        return profile != null ? profile.employeeId : null;
      }

      allow get: if isSignedIn() && (isAdmin() || getEmployeeId() == employeeId);
      allow list: if isAdmin();
      allow create: if false; 
      allow update: if isUserActive() && (
        (isAdmin() && (isSuperAdmin() || isMemberOf(resource.data.office))) ||
        (getEmployeeId() == employeeId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['age']))
      );
      allow delete: if isSuperAdmin();
    }

    // --- OPERATIONS ---

    match /weekoff_configs/{configId} {
      allow read: if isUserActive() && (isSuperAdmin() || resource == null || isMemberOf(resource.data.office));
      allow create: if isAdmin() && (isSuperAdmin() || isMemberOf(request.resource.data.office));
      allow update: if (isAdmin() && (isSuperAdmin() || isMemberOf(request.resource.data.office)))
                    || (isUserActive() && isMemberOf(request.resource.data.office) 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    match /weekoff_bookings/{bookingId} {
      function getEmployeeId() {
        let profile = getProfile();
        return profile != null ? profile.employeeId : null;
      }

      allow read: if isUserActive() && (isSuperAdmin() || resource == null || resource.data.employeeId == getEmployeeId() || isMemberOf(resource.data.office));
      allow create: if isUserActive() && (isSuperAdmin() || (request.resource.data.employeeId == getEmployeeId() && isMemberOf(request.resource.data.office)));
      allow delete, update: if isSuperAdmin();
    }

    match /published_rosters/{versionId} { 
      allow read: if isUserActive() && (isAdmin() || (resource != null && isMemberOf(resource.data.office))); 
      allow write: if isAdmin() && (isSuperAdmin() || isMemberOf(request.resource.data.office));
    }
    
    match /roster_quotas/{quotaId} { 
      allow read: if isUserActive() && (isAdmin() || (resource != null && isMemberOf(resource.data.officeId)));
      allow write: if isAdmin() && (isSuperAdmin() || isMemberOf(request.resource.data.officeId));
    }

    match /roster_drafts/{draftId} { 
      allow read: if isAdmin() && (isSuperAdmin() || isMemberOf(resource.data.office)); 
      allow write: if isAdmin() && (isSuperAdmin() || isMemberOf(request.resource.data.office)); 
    }

    match /shift_adjacency_rules/{ruleId} {
      allow read: if isAdmin() && (isSuperAdmin() || isMemberOf(resource.data.office));
      allow write: if isAdmin() && (isSuperAdmin() || isMemberOf(request.resource.data.office));
    }

    match /employee_leaves/{leaveId} {
      function getEmployeeId() {
        let profile = getProfile();
        return profile != null ? profile.employeeId : null;
      }

      allow read: if isUserActive() && (isAdmin() || (resource != null && (resource.data.employeeId == getEmployeeId() || isMemberOf(resource.data.office))));
      allow create: if isAdmin() && (isSuperAdmin() || isMemberOf(request.resource.data.office));
      allow update: if isAdmin() && (isSuperAdmin() || isMemberOf(resource.data.office));
      allow delete: if isSuperAdmin();
    }

    match /shift_swaps/{swapId} {
      function getEmployeeId() {
        let profile = getProfile();
        return profile != null ? profile.employeeId : null;
      }

      allow read: if isUserActive() && (
        isSuperAdmin() || 
        (resource != null && (
          (isAdmin() && isMemberOf(resource.data.office)) || 
          resource.data.requesterId == getEmployeeId() || 
          resource.data.targetEmployeeId == getEmployeeId()
        ))
      );
      allow create: if isUserActive() && request.resource.data.requesterId == getEmployeeId() && isMemberOf(request.resource.data.office);
      allow update: if isUserActive() && (request.resource.data.targetEmployeeId == getEmployeeId() || (isAdmin() && isMemberOf(request.resource.data.office)));
    }

    match /employee_preferences/{prefId} {
      function getEmployeeId() {
        let profile = getProfile();
        return profile != null ? profile.employeeId : null;
      }

      allow read: if isUserActive() && (isAdmin() || (resource != null && (resource.data.employeeId == getEmployeeId() || isMemberOf(resource.data.office))));
      allow write: if isUserActive() && request.resource.data.employeeId == getEmployeeId() && isMemberOf(request.resource.data.office);
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && isMemberOf(resource.data.office));
      allow create: if isSignedIn(); 
    }

    match /whatsapp_logs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && isMemberOf(resource.data.office));
      allow create: if isSignedIn(); 
    }
    
    match /otp_registry/{phone} {
      allow read: if isSuperAdmin();
      allow write: if true; 
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.uid);
    }
  }
}
