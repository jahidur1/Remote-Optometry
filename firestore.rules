
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerRecord(employeeId) {
       return isSignedIn() && get(/databases/$(database)/documents/employees/$(employeeId)).data.whatsappNumber == request.auth.token.phone_number;
    }

    // Employees Collection - SECURED
    match /employees/{employeeId} {
      // Admins can manage all records. 
      // Employees can only 'get' their own record to verify identity post-login.
      allow get: if isSignedIn() && (isAdmin() || resource.data.whatsappNumber == request.auth.token.phone_number);
      allow list: if isAdmin();
      allow create: if isAdmin();
      
      // Employees can only update self-managed fields (Age, Email).
      // Block modification of Role, Status, Phone, and ID.
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.whatsappNumber == request.auth.token.phone_number &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'whatsappNumber', 'id', 'joinedAt'])
      );
      allow delete: if isAdmin();
    }

    // Users Collection (Auth Mapping)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Sessions Collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); 
    }
    
    // Workforce Collections
    match /shift_master/{shiftId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /weekoff_configs/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /weekoff_bookings/{bookingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.employeeId == getUserData().employeeId || isAdmin()); 
    }
    
    match /employee_leaves/{leaveId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.employeeId == getUserData().employeeId);
    }
    
    match /roster_quotas/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /roster_drafts/{draftId} {
      allow read, write: if isAdmin();
    }
    
    match /published_rosters/{versionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /whatsapp_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }
    
    match /employee_preferences/{prefId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.employeeId == getUserData().employeeId;
    }

    match /shift_swaps/{swapId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }
  }
}
