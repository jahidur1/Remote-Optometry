
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Firebase Auth user profile with role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "displayName": { "type": "string" },
        "employeeId": { "type": "string", "description": "Link to the Employee record" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Permanent employee record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Internal ID (e.g., EMP001)" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "whatsappNumber": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date" },
        "department": { "type": "string" },
        "designation": { "type": "string" },
        "eligibility": { "type": "array", "items": { "type": "string" } },
        "authUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role", "status"]
    },
    "Shift": {
      "title": "Shift Master",
      "description": "Core shift definitions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "displayOrder": { "type": "number" }
      }
    },
    "RosterQuota": {
      "title": "Roster Quota Configuration",
      "description": "Exact staffing requirements and gender targets for a roster week.",
      "type": "object",
      "properties": {
        "weekId": { "type": "string" },
        "quotas": { "type": "object", "description": "Map of dayOfWeek_shiftId to requiredCount" },
        "genderTargets": { "type": "object", "description": "Map of shiftId to { male: string, female: string }" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "actorId": { "type": "string" }
      }
    },
    "RosterDraft": {
      "title": "Roster Draft",
      "description": "Generated shift assignments awaiting review.",
      "type": "object",
      "properties": {
        "weekId": { "type": "string" },
        "version": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "validated", "published"] },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "employeeId": { "type": "string" },
              "dayOfWeek": { "type": "string" },
              "shiftId": { "type": "string" }
            }
          }
        },
        "solverStatus": { "type": "string" },
        "solverMetadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "RosterPublished": {
      "title": "Published Roster",
      "description": "Official authorized roster version.",
      "type": "object",
      "properties": {
        "weekId": { "type": "string" },
        "version": { "type": "number" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "publisherId": { "type": "string" },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "employeeId": { "type": "string" },
              "dayOfWeek": { "type": "string" },
              "shiftId": { "type": "string" }
            }
          }
        }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Immutable log of sensitive actions.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actorId": { "type": "string" },
        "targetId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role access."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master employee records."
    },
    "/shift_master/{shiftId}": {
      "schema": "Shift",
      "description": "Definitions of the 6 core shifts."
    },
    "/roster_quotas/{weekId}": {
      "schema": "RosterQuota",
      "description": "Exact shift quotas and gender targets."
    },
    "/roster_drafts/{draftId}": {
      "schema": "RosterDraft",
      "description": "Unpublished roster generations."
    },
    "/published_rosters/{versionId}": {
      "schema": "RosterPublished",
      "description": "The official authorized roster versions."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System-wide audit trail."
    }
  }
}
