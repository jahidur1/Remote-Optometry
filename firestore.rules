
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INSTITUTIONAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isUserActive() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.status == 'Active';
    }
    
    function isAdmin() {
      let profile = getProfile();
      return isUserActive() && profile != null && (profile.role == 'admin' || profile.role == 'super_admin' || profile.role == 'ADMIN' || profile.role == 'SUPER_ADMIN');
    }

    function isSuperAdmin() {
      let profile = getProfile();
      return isUserActive() && profile != null && (profile.role == 'super_admin' || profile.role == 'SUPER_ADMIN');
    }

    // Office-based Authorization Pulse: Enforces isolation for multi-office admins
    function matchesOffice(officeId) {
      let profile = getProfile();
      return isSuperAdmin() || (profile != null && (profile.office == officeId || (profile.officeIds != null && officeId in profile.officeIds)));
    }

    // --- SYSTEM GOVERNANCE ---

    match /system_settings/whatsapp_config {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    
    match /system_settings/whatsapp_automation {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // --- REGISTRY & ROSTERS ---

    match /offices/{officeId} {
      allow read: if isSignedIn(); 
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSuperAdmin(); 
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn() && (isSuperAdmin() || matchesOffice(resource.data.office));
      allow create, delete: if isSuperAdmin();
      allow update: if isUserActive() && (isSuperAdmin() || matchesOffice(resource.data.office));
    }

    match /published_rosters/{rosterId} { 
      allow read: if isUserActive() && matchesOffice(resource.data.office); 
      allow write: if isAdmin() && matchesOffice(request.resource.data.office);
    }

    match /whatsapp_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); 
    }

    match /roster_quotas/{quotaId} { 
      allow read: if isUserActive() && matchesOffice(resource.data.office);
      allow write: if isAdmin() && matchesOffice(request.resource.data.office);
    }

    match /roster_drafts/{draftId} { 
      allow read: if isAdmin() && matchesOffice(resource.data.office); 
      allow write: if isAdmin() && matchesOffice(request.resource.data.office); 
    }

    match /shift_master/{shiftId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /weekoff_configs/{configId} {
      allow read: if isUserActive() && matchesOffice(resource.data.office);
      allow write: if isAdmin() && matchesOffice(request.resource.data.office);
    }

    match /weekoff_bookings/{bookingId} {
      allow read: if isUserActive() && matchesOffice(resource.data.office);
      allow create: if isUserActive() && matchesOffice(request.resource.data.office);
      allow delete, update: if isSuperAdmin();
    }
    
    match /shift_swaps/{swapId} {
      allow read: if isUserActive() && matchesOffice(resource.data.office);
      allow create: if isUserActive();
      allow update: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == resource.data.uid);
    }
    
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
    }
  }
}
