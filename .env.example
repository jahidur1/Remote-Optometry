# --- FIREBASE PUBLIC CONFIG ---
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}'
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY="YOUR_SITE_KEY_FROM_CLOUD_CONSOLE"

# --- SERVER-SIDE OPTIMIZATION (CLOUD RUN) ---
SOLVER_URL="https://roc-workforce-solver-xyz-as.a.run.app"
ENABLE_IAM_AUTH="true"

# --- META WHATSAPP CLOUD API (LOCAL DEV ONLY) ---
# For production, these must be set via `firebase functions:secrets:set`
WHATSAPP_PHONE_NUMBER_ID="1143569695505848"
WHATSAPP_ACCESS_TOKEN="YOUR_PERMANENT_SYSTEM_USER_TOKEN"

# --- INSTITUTIONAL TRIGGER (PULSE AUTH) ---
INTERNAL_TRIGGER_KEY="YOUR_RANDOM_SHARED_SECRET"
APP_URL="https://your-app-hosting-url.web.app"
