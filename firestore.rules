
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INSTITUTIONAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(path) && get(path).data.status == 'Active';
    }
    
    function isAdmin() {
      return isUserActive() && getUserData().role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isSuperAdmin() {
      return isUserActive() && getUserData().role == 'SUPER_ADMIN';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Dynamic Office Status Check
    function isOfficeActive(officeId) {
      let path = /databases/$(database)/documents/offices/$(officeId);
      return exists(path) && get(path).data.status == 'Active';
    }

    // Cluster Isolation: Validates if user belongs to the specific ROC node
    function matchesOffice(officeId) {
      let user = getUserData();
      return isUserActive() && (
        user.role == 'SUPER_ADMIN' ||
        (user.role == 'ADMIN' && (
          (user.keys().contains('officeIds') && officeId in user.officeIds) ||
          (!user.keys().contains('officeIds') && user.office == officeId)
        )) ||
        (user.role == 'EMPLOYEE' && user.office == officeId)
      );
    }

    // --- PHASE 2: REGISTRY MANAGEMENT ---

    match /offices/{officeId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() && officeId == request.resource.data.officeId;
      allow update: if isSuperAdmin() && 
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.shortCode == resource.data.shortCode;
      allow delete: if false;
    }

    match /registry_short_codes/{code} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- PHASE 1: IDENTITY & PRIVILEGE PROTECTION ---

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if false; 
    }

    match /employees/{employeeId} {
      function getEmployeeId() {
        let path = /databases/$(database)/documents/users/$(request.auth.uid);
        return exists(path) ? get(path).data.employeeId : null;
      }

      allow get: if isSignedIn() && (isAdmin() || getEmployeeId() == employeeId);
      allow list: if isAdmin() && (isSuperAdmin() || matchesOffice(resource.data.office));

      allow create: if false;

      allow update: if isUserActive() && (
        (isAdmin() && matchesOffice(resource.data.office) && 
         request.resource.data.diff(resource.data).affectedKeys()
          .only(['fullName', 'whatsappNumber', 'department', 'designation', 'age'])) ||
        
        (getEmployeeId() == employeeId && 
         request.resource.data.diff(resource.data).affectedKeys().only(['age']) &&
         request.resource.data.age is int && 
         request.resource.data.age >= 18 && 
         request.resource.data.age <= 80)
      );

      allow delete: if isSuperAdmin();
    }

    // --- OPERATIONS (OFFICE SCOPED & STATUS AWARE) ---

    match /weekoff_configs/{configId} {
      allow read: if isUserActive() && matchesOffice(resource.data.office);
      allow write: if isAdmin() && 
        matchesOffice(request.resource.data.office) && 
        isOfficeActive(request.resource.data.office);
    }

    match /weekoff_bookings/{bookingId} {
      allow read: if isUserActive() && (
        resource.data.employeeId == getUserData().employeeId || 
        matchesOffice(resource.data.office)
      );
      allow create: if isUserActive() && 
        request.resource.data.employeeId == getUserData().employeeId &&
        matchesOffice(request.resource.data.office) &&
        isOfficeActive(request.resource.data.office);
      allow update: if isAdmin() && matchesOffice(resource.data.office);
      allow delete: if isAdmin() && matchesOffice(resource.data.office);
    }

    match /published_rosters/{versionId} { 
      allow read: if isUserActive() && matchesOffice(resource.data.office); 
      allow write: if isAdmin() && 
        matchesOffice(request.resource.data.office) &&
        isOfficeActive(request.resource.data.office);
    }
    
    match /roster_quotas/{quotaId} { 
      allow read: if isUserActive() && (
        !quotaId.contains('_') || 
        matchesOffice(resource.data.officeId)
      );
      allow write: if isAdmin() && 
        matchesOffice(request.resource.data.officeId) &&
        isOfficeActive(request.resource.data.officeId) &&
        quotaId == request.resource.data.weekId + "_" + request.resource.data.officeId;
      allow delete: if isSuperAdmin();
    }
    
    match /roster_drafts/{draftId} { 
      allow read: if isAdmin() && matchesOffice(resource.data.office); 
      allow write: if isAdmin() && 
        matchesOffice(request.resource.data.office) &&
        isOfficeActive(request.resource.data.office); 
    }

    // --- LOGS & AUDIT (IMMUTABLE) ---

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid; 
    }

    match /whatsapp_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); 
    }
    
    // Sessions and OTP (Global)
    match /otp_registry/{phone} {
      allow read: if isSuperAdmin();
      allow create: if true; 
      allow update, delete: if isSuperAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        (isAdmin() && request.resource.data.status == 'revoked') ||
        (request.auth.uid == resource.data.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'deadlineAt', 'verifiedAt']))
      );
    }
  }
}
