
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isUserActive() {
      return isSignedIn() && getUserData().status == 'Active';
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- WEEKOFF CONFIGURATIONS ---
    match /weekoff_configs/{configId} {
      // Employees can only see configurations for their specific office ID
      allow read: if isUserActive() && (isAdmin() || resource.data.office == getUserData().office);
      allow write: if isAdmin() && isUserActive();
    }

    // --- WEEKOFF BOOKINGS ---
    match /weekoff_bookings/{bookingId} {
      allow read: if isUserActive() && (resource.data.employeeId == getUserData().employeeId || isAdmin());
      
      // Creation logic: user can only book for themselves and must match their office schedule
      allow create: if isUserActive() && 
        request.resource.data.employeeId == getUserData().employeeId &&
        request.resource.data.status == 'confirmed' &&
        request.resource.data.office == getUserData().office;
      
      allow update, delete: if isAdmin() && isUserActive();
    }

    // --- SESSIONS COLLECTION ---
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.deadlineAt == request.time + duration.value(31536000, 's');

      allow update: if isSignedIn() && (
        (isAdmin() && request.resource.data.status == 'revoked') ||
        (request.auth.uid == resource.data.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'deadlineAt', 'verifiedAt']))
      );
      
      allow delete: if false;
    }

    // --- EMPLOYEES COLLECTION ---
    match /employees/{employeeId} {
      allow get: if isUserActive() && (isAdmin() || resource.data.whatsappNumber == request.auth.token.phone_number);
      allow list: if isAdmin() && isUserActive();
      allow create: if isAdmin() && isUserActive();
      
      // Field level locking: Employees cannot change Name, ID, Office, Gender, Mobile, Role, Status
      allow update: if (isAdmin() && isUserActive()) || (
        isUserActive() && 
        resource.data.whatsappNumber == request.auth.token.phone_number &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'whatsappNumber', 'id', 'joinedAt', 'fullName', 'office', 'gender'])
      );
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if (isOwner(userId) || isAdmin()) && isSignedIn();
    }

    // --- AUDIT LOGS ---
    match /audit_logs/{logId} {
      allow read: if isAdmin() && isUserActive();
      allow create: if isSignedIn(); 
      allow update, delete: if false;
    }
    
    // --- GENERIC WORKFORCE DATA ---
    match /{path=**}/shift_master/{shiftId} { allow read: if isUserActive(); }
    match /{path=**}/employee_leaves/{leaveId} { allow read: if isUserActive(); }
    match /{path=**}/published_rosters/{versionId} { allow read: if isUserActive(); }
    match /{path=**}/shift_adjacency_rules/{ruleId} { allow read: if isUserActive(); allow write: if isAdmin(); }
    match /{path=**}/employee_preferences/{prefId} { allow read: if isUserActive(); allow write: if isUserActive(); }
    match /{path=**}/roster_quotas/{quotaId} { allow read: if isUserActive(); allow write: if isAdmin(); }
    match /{path=**}/roster_drafts/{draftId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /{path=**}/shift_swaps/{swapId} { allow read: if isUserActive(); allow write: if isUserActive(); }
  }
}
