
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- INSTITUTIONAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }
    
    // Safety check for user activity status
    function isUserActive() {
      let data = getUserData();
      return isSignedIn() && data != null && data.status == 'Active';
    }
    
    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'SUPER_ADMIN';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Cluster Isolation: Validates if user belongs to the specific ROC node
    function matchesOffice(office) {
      let data = getUserData();
      return isAdmin() || (data != null && data.office == office);
    }

    // --- GOVERNANCE: OTP REGISTRY (12h Backup Failsafe) ---
    match /otp_registry/{phone} {
      allow read: if isSuperAdmin();
      allow create: if true; // Publicly writable during login pulse initiation
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // --- SECURITY: SESSIONS (365-Day Mandatory Deadline) ---
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      
      // Create only allowed with a strict 365-day expiration window
      allow create: if isSignedIn() && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.deadlineAt == request.time + duration.value(31536000, 's');

      allow update: if isSignedIn() && (
        (isAdmin() && request.resource.data.status == 'revoked') ||
        (request.auth.uid == resource.data.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'deadlineAt', 'verifiedAt']))
      );
      
      allow delete: if false; // Sessions are revoked/expired, never deleted for audit integrity
    }

    // --- WORKFORCE: EMPLOYEES (Identity Registry) ---
    match /employees/{employeeId} {
      // Handshake: Allow identity verification if phone matches auth token
      allow get: if isSignedIn() && (
        isAdmin() || 
        resource.data.whatsappNumber == request.auth.token.phone_number
      );
      allow list: if isSignedIn() && (
        isAdmin() || 
        request.query.limit <= 5 // Restricted listing for self-identification
      );
      allow create: if isAdmin() && isUserActive();
      
      allow update: if (isAdmin() && isUserActive()) || (
        isUserActive() && 
        resource.data.whatsappNumber == request.auth.token.phone_number &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'whatsappNumber', 'id', 'joinedAt', 'fullName', 'office', 'gender', 'department', 'designation'])
      );
    }

    // --- USERS: AUTH PROFILES ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if (isOwner(userId) || isAdmin()) && isSignedIn();
    }

    // --- OPERATIONS: WEEK-OFFS ---
    match /weekoff_configs/{configId} {
      allow read: if isUserActive() && matchesOffice(resource.data.office);
      allow write: if isAdmin() && isUserActive();
    }

    match /weekoff_bookings/{bookingId} {
      allow read: if isUserActive() && (resource.data.employeeId == getUserData().employeeId || isAdmin());
      
      allow create: if isUserActive() && 
        request.resource.data.employeeId == getUserData().employeeId &&
        request.resource.data.status == 'confirmed' &&
        request.resource.data.office == getUserData().office;
      
      allow update: if (isSuperAdmin() || isAdmin()) && isUserActive();
      allow delete: if isAdmin() && isUserActive();
    }

    // --- OPERATIONS: EXCHANGES (Shift Swaps) ---
    match /shift_swaps/{swapId} {
      allow read: if isUserActive() && (
        resource.data.requesterId == getUserData().employeeId || 
        resource.data.targetEmployeeId == getUserData().employeeId || 
        isAdmin()
      );
      allow create: if isUserActive() && request.resource.data.requesterId == getUserData().employeeId;
      allow update: if isUserActive() && (
        request.resource.data.targetEmployeeId == getUserData().employeeId || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- OPERATIONS: PREFERENCES ---
    match /employee_preferences/{prefId} {
      allow read: if isUserActive();
      allow write: if isUserActive() && request.resource.data.employeeId == getUserData().employeeId;
    }

    // --- AUDIT & MESSAGING ---
    match /audit_logs/{logId} {
      allow read: if isAdmin() && isUserActive();
      allow create: if isSignedIn(); 
    }

    match /whatsapp_logs/{logId} {
      allow read: if isAdmin() && isUserActive();
      allow create: if isSignedIn(); 
    }

    // --- MASTER DATA & ROSTER ENGINE ---
    match /shift_master/{shiftId} { 
      allow read: if isUserActive(); 
      allow write: if isAdmin();
    }
    
    match /employee_leaves/{leaveId} { 
      allow read: if isUserActive(); 
      allow write: if isAdmin();
    }
    
    match /published_rosters/{versionId} { 
      allow read: if isUserActive() && matchesOffice(resource.data.office); 
      allow write: if isAdmin();
    }
    
    match /roster_quotas/{quotaId} { 
      allow read: if isUserActive(); 
      allow write: if isAdmin();
    }
    
    match /roster_drafts/{draftId} { 
      allow read: if isAdmin() && isUserActive(); 
      allow write: if isAdmin() && isUserActive(); 
    }
    
    match /shift_adjacency_rules/{ruleId} { 
      allow read: if isUserActive(); 
      allow write: if isAdmin();
    }
  }
}
