
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isUserActive() {
      return isSignedIn() && getUserData().status == 'Active';
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- WEEKOFF CONFIGURATIONS ---
    match /weekoff_configs/{weekId} {
      allow read: if isUserActive();
      // Quotas and windows can only be managed by admins
      allow write: if isAdmin() && isUserActive();
    }

    // --- WEEKOFF BOOKINGS (The Atomic Layer) ---
    match /weekoff_bookings/{bookingId} {
      allow read: if isUserActive() && (resource.data.employeeId == getUserData().employeeId || isAdmin());
      
      // Strict creation logic: user can only book for themselves
      allow create: if isUserActive() && 
        request.resource.data.employeeId == getUserData().employeeId &&
        request.resource.data.status == 'confirmed';
      
      // Bookings are immutable once secured (locked)
      allow update, delete: if isAdmin() && isUserActive();
    }

    // --- SESSIONS COLLECTION ---
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.deadlineAt == request.time + duration.value(31536000, 's');

      allow update: if isSignedIn() && (
        (isAdmin() && request.resource.data.status == 'revoked') ||
        (request.auth.uid == resource.data.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'deadlineAt', 'verifiedAt']))
      );
      
      allow delete: if false;
    }

    // --- EMPLOYEES COLLECTION ---
    match /employees/{employeeId} {
      allow get: if isUserActive() && (isAdmin() || resource.data.whatsappNumber == request.auth.token.phone_number);
      allow list: if isAdmin() && isUserActive();
      allow create: if isAdmin() && isUserActive();
      allow update: if (isAdmin() && isUserActive()) || (
        isUserActive() && 
        resource.data.whatsappNumber == request.auth.token.phone_number &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'whatsappNumber', 'id', 'joinedAt'])
      );
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if (isOwner(userId) || isAdmin()) && isSignedIn();
    }

    // --- AUDIT LOGS ---
    match /audit_logs/{logId} {
      allow read: if isAdmin() && isUserActive();
      allow create: if isSignedIn(); 
      allow update, delete: if false;
    }
    
    // --- GENERIC WORKFORCE DATA ---
    match /{path=**}/shift_master/{shiftId} { allow read: if isUserActive(); }
    match /{path=**}/employee_leaves/{leaveId} { allow read: if isUserActive(); }
    match /{path=**}/published_rosters/{versionId} { allow read: if isUserActive(); }
  }
}
