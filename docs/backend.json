
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Firebase Auth user profile with role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "displayName": { "type": "string" },
        "employeeId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] }
      },
      "required": ["uid", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Permanent clinical professional record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "age": { "type": "number" },
        "office": { "type": "string", "enum": ["Kolkata ROC", "Gurgaon ROC", "Lucknow ROC"] },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "whatsappNumber": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date" },
        "department": { "type": "string" },
        "designation": { "type": "string" }
      },
      "required": ["id", "fullName", "whatsappNumber", "office", "role", "status"]
    },
    "WeekOffConfig": {
      "title": "Week-Off Configuration",
      "description": "Scheduled FCFS window for a specific office.",
      "type": "object",
      "properties": {
        "weekId": { "type": "string" },
        "office": { "type": "string" },
        "bookingOpen": { "type": "string", "format": "date-time" },
        "bookingClose": { "type": "string", "format": "date-time" },
        "quotas": { "type": "object" },
        "booked": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role access."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master employee records."
    },
    "/weekoff_configs/{configId}": {
      "schema": "WeekOffConfig",
      "description": "Office-specific booking window settings."
    }
  }
}
