# ROC Workforce — Institutional Environment Template
# Copy this file to .env.local and populate with verified credentials.

# --- FIREBASE APP CONFIG ---
# Public configuration for the client SDK. Safe to expose.
# Obtained from Firebase Console > Project Settings > Web App
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey": "...", "authDomain": "...", "projectId": "...", "storageBucket": "...", "messagingSenderId": "...", "appId": "..."}'

# --- SECURITY: APP CHECK ---
# reCAPTCHA Enterprise Site Key (Public)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY="..."

# --- META WHATSAPP CLOUD API ---
# Permanent System User Access Token (SECRET)
# Do NOT put this in NEXT_PUBLIC variables.
WHATSAPP_ACCESS_TOKEN="..."

# Meta Phone Number ID (Public/Static)
# 1143569695505848
WHATSAPP_PHONE_NUMBER_ID="1143569695505848"

# --- OPTIMIZATION ENGINE ---
# Endpoint for the OR-Tools Cloud Run solver.
SOLVER_URL="..."
ENABLE_IAM_AUTH="true"

# --- INTERNAL AUTHENTICATION ---
# Shared secret for cron pulse authorization.
INTERNAL_TRIGGER_KEY="..."
APP_URL="https://roc-workforce.web.app"
