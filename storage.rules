
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- INSTITUTIONAL HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getProfile() {
      // Secure cross-service lookup: verify role and employeeId from Firestore
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.status == 'Active';
    }

    function isAdmin() {
      let profile = getProfile();
      return isUserActive() && (profile.role == 'admin' || profile.role == 'super_admin');
    }

    function isSuperAdmin() {
      let profile = getProfile();
      return isUserActive() && profile.role == 'super_admin';
    }

    // --- CLINICAL REGISTRY: DAILY ROSTER DOCUMENTS ---
    match /whatsapp-roster-pdfs/{year}/{month}/{employeeId}/{fileName} {
      allow read: if isUserActive() && (getProfile().employeeId == employeeId || isAdmin());
      allow write: if false;
    }

    // --- CLINICAL REGISTRY: WEEKLY ROSTER DOCUMENTS ---
    match /weekly-roster-pdfs/{officeId}/{weekId}/{employeeId}/{fileName} {
      allow read: if isUserActive() && (getProfile().employeeId == employeeId || isAdmin());
      allow write: if false;
    }

    // --- SYSTEM ASSETS: LOGOS & BRANDING ---
    match /system_assets/{allPaths=**} {
      allow read: if isUserActive();
      allow write: if isSuperAdmin();
    }
    
    // --- ADMINISTRATIVE FALLBACK ---
    match /audit_traces/{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
