
# ROC WORKFORCE — INSTITUTIONAL ENVIRONMENT TEMPLATE
# Copy this file to .env.local and populate with verified registry values.

# --- CLINICAL SOLVER NODE ---
# Endpoint for the OR-Tools CP-SAT optimization engine
SOLVER_URL=https://your-solver-service-url.a.run.app
ENABLE_IAM_AUTH=true

# --- META WHATSAPP CLOUD API ---
# These must match the values in the Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID=1143569695505848
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token

# --- INSTITUTIONAL SECURITY ---
# Shared secret for authorizing the 10 PM clinical pulse
INTERNAL_TRIGGER_KEY=generate_a_random_secure_string

# --- FIREBASE APP CHECK ---
# reCAPTCHA Enterprise Site Key from Google Cloud Console
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# --- APPLICATION CONTEXT ---
# Base URL for the deployed Next.js application
APP_URL=https://your-app-id.web.app
