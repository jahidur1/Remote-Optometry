
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Firebase Auth user profile with role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "displayName": { "type": "string" },
        "employeeId": { "type": "string", "description": "Link to the Employee record" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Permanent employee record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Internal ID (e.g., EMP001)" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "whatsappNumber": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date" },
        "department": { "type": "string" },
        "designation": { "type": "string" },
        "eligibility": { "type": "array", "items": { "type": "string" } },
        "authUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role", "status"]
    },
    "Shift": {
      "title": "Shift Master",
      "description": "Core shift definitions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "displayOrder": { "type": "number" }
      }
    },
    "WeekOffConfig": {
      "title": "Weekly-Off Configuration",
      "description": "Admin settings for a specific week's booking window.",
      "type": "object",
      "properties": {
        "weekId": { "type": "string", "description": "Format: YYYY-WW" },
        "bookingOpen": { "type": "string", "format": "date-time" },
        "bookingClose": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["scheduled", "open", "closed", "completed"] },
        "quotas": {
          "type": "object",
          "properties": {
            "Monday": { "type": "number" },
            "Tuesday": { "type": "number" },
            "Wednesday": { "type": "number" },
            "Thursday": { "type": "number" },
            "Friday": { "type": "number" },
            "Saturday": { "type": "number" },
            "Sunday": { "type": "number" }
          }
        },
        "booked": {
          "type": "object",
          "properties": {
            "Monday": { "type": "number" },
            "Tuesday": { "type": "number" },
            "Wednesday": { "type": "number" },
            "Thursday": { "type": "number" },
            "Friday": { "type": "number" },
            "Saturday": { "type": "number" },
            "Sunday": { "type": "number" }
          }
        }
      }
    },
    "WeekOffBooking": {
      "title": "Weekly-Off Booking",
      "description": "A confirmed weekly-off reservation for an employee.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "weekId_employeeId" },
        "weekId": { "type": "string" },
        "employeeId": { "type": "string" },
        "dayOfWeek": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["confirmed", "cancelled", "overridden"] },
        "actorId": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Immutable log of sensitive actions.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actorId": { "type": "string" },
        "targetId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role access."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master employee records."
    },
    "/shift_master/{shiftId}": {
      "schema": "Shift",
      "description": "Definitions of the 6 core shifts."
    },
    "/weekoff_configs/{weekId}": {
      "schema": "WeekOffConfig",
      "description": "Admin configuration for weekly-off booking."
    },
    "/weekoff_bookings/{bookingId}": {
      "schema": "WeekOffBooking",
      "description": "Confirmed employee weekly-off bookings."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System-wide audit trail."
    }
  }
}
