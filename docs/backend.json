
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Firebase Auth user profile with role and multi-office access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "displayName": { "type": "string" },
        "employeeId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "office": { "type": "string" },
        "officeIds": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] }
      },
      "required": ["uid", "role"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global configuration for WhatsApp and institutional branding.",
      "type": "object",
      "properties": {
        "whatsappEnabled": { "type": "boolean" },
        "logoBase64": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Employee": {
      "title": "Employee",
      "description": "Permanent clinical professional record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "office": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "whatsappNumber": { "type": "string" }
      },
      "required": ["id", "fullName", "whatsappNumber", "office", "role", "status"]
    }
  },
  "auth": {
    "providers": ["phone", "google.com", "password"]
  },
  "firestore": {
    "/system_settings/whatsapp_config": {
      "schema": "SystemSettings",
      "description": "Global Meta integration and branding config."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master employee records."
    },
    "/published_rosters/{rosterId}": {
      "schema": "object",
      "description": "Deterministic clinical roster assignments."
    },
    "/whatsapp_logs/{logId}": {
      "schema": "object",
      "description": "Trace ledger for Meta API transmissions."
    }
  }
}
