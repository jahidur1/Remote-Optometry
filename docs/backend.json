
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Firebase Auth user profile with role and multi-office access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "displayName": { "type": "string" },
        "employeeId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "office": { "type": "string", "enum": ["KOLKATA_ROC", "GURGAON_ROC", "LUCKNOW_ROC"] },
        "officeIds": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["KOLKATA_ROC", "GURGAON_ROC", "LUCKNOW_ROC"] },
          "description": "List of authorized ROC units for Admins."
        },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] }
      },
      "required": ["uid", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Permanent clinical professional record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "age": { "type": "number" },
        "office": { "type": "string", "enum": ["KOLKATA_ROC", "GURGAON_ROC", "LUCKNOW_ROC"] },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "EMPLOYEE"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "whatsappNumber": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date" },
        "department": { "type": "string" },
        "designation": { "type": "string" }
      },
      "required": ["id", "fullName", "whatsappNumber", "office", "role", "status", "gender"]
    },
    "OtpPulse": {
      "title": "OTP Pulse",
      "description": "Temporary 12-hour backup OTP for administrative support.",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "otp": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["phone", "google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role and multi-office access."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master employee records."
    },
    "/weekoff_configs/{configId}": {
      "schema": "WeekOffConfig",
      "description": "Office-specific booking window settings."
    },
    "/otp_registry/{phone}": {
      "schema": "OtpPulse",
      "description": "12-hour temporary backup OTP pulses."
    }
  }
}
