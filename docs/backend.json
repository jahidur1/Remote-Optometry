
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Firebase Auth user profile with role and multi-office access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "displayName": { "type": "string" },
        "employeeId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "office": { "type": "string", "description": "Primary office ID from the /offices registry." },
        "officeIds": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of authorized ROC units for Admins."
        },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] }
      },
      "required": ["uid", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Permanent clinical professional record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "age": { "type": "number" },
        "office": { "type": "string", "description": "Assigned office ID from the /offices registry." },
        "role": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Suspended"] },
        "whatsappNumber": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date" },
        "department": { "type": "string" },
        "designation": { "type": "string" }
      },
      "required": ["id", "fullName", "whatsappNumber", "office", "role", "status", "gender"]
    },
    "Office": {
      "title": "Office",
      "description": "ROC Cluster Node within the institutional registry.",
      "type": "object",
      "properties": {
        "officeId": { "type": "string" },
        "officeName": { "type": "string" },
        "shortCode": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["officeId", "officeName", "shortCode", "status"]
    }
  },
  "auth": {
    "providers": ["phone", "google.com", "password"]
  },
  "firestore": {
    "/offices/{officeId}": {
      "schema": "Office",
      "description": "Master ROC cluster registry."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role and multi-office access."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master employee records."
    },
    "/weekoff_configs/{configId}": {
      "schema": "WeekOffConfig",
      "description": "Office-specific booking window settings."
    },
    "/roster_quotas/{quotaId}": {
      "schema": "OtpPulse",
      "description": "Localized staffing requirements (weekId_officeId)."
    }
  }
}
